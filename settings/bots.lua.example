-----------------------------------
-- BOT SETTINGS (modules/bots)
-----------------------------------
-- The pool itself is the bot_pool table. A row with charid 0 gets its account and character on the next start.

xi          = xi or {}
xi.settings = xi.settings or {}

xi.settings.bots =
{
    ENABLED        = true,
    MAX_ONLINE     = 36,  -- Bots online at once while real players are connected; those in a zone with no real player stand idle
    LOGIN_INTERVAL = 8,   -- Seconds between bot logins
    LOGOUT_GRACE   = 180, -- Seconds after the last real player leaves before the bots go
    ROTATE_MINUTES = 20,  -- Every this many minutes one bot outside a party swaps for another. 0 turns it off
    SESSION_MIN    = 20,  -- Minutes. Each login rolls a session at least this long
    SESSION_MAX    = 120, -- Minutes. And at most this long. At the end the bot logs out once it is free. 0 turns sessions off
    CATCH_UP       = true, -- Exp for time offline, granted once on the next login after at least an hour away. false turns it off
    ACTIVE_EVERYWHERE = false, -- Test: bots in zones with no real player hunt and fight too, instead of standing idle. Costs tick time

    BOTS_PER_PLAYER_ZONE = 3,  -- Bots outside a party kept in every zone a real player is in. 0 turns it off
    CAMP_CHANCE          = 70, -- Percent of logins that start at a camp for the bot's level instead of the pool home
    HUNT                 = true, -- Bots without a party hunt monsters near their level, in zones with real players
    BOT_PARTIES          = true, -- Unpartied bots in a zone with real players sometimes team up and hunt together
    SOLO_BELOW           = 10, -- Bots below this level solo in a starting area and are not put in bot-only parties. 0 turns this off
    SOLO_ACTIVE          = true, -- Those soloing bots hunt even when no real player is in their zone. false keeps them idle until one is, as before

    -- Gathering at a HELM point (harvesting, logging, mining, excavation). false leaves every bot behaving as before.
    GATHERING            = false, -- Solo bots may gather at a visible point in the zone. false changes nothing
    GATHER_CHANCE        = 15,    -- Percent. Each time a solo bot has nothing to hunt, the chance it gathers instead if a point is within 80 yalms

    INVITE_SEEKERS       = true, -- A bot party at a camp, or in a fight, tells one seeking player it has room for, then invites. A tell of "no invites" stops that until restart

    -- Townsfolk. The CITIZENS pool rows with the lowest char ids stay in one city: they walk, sit, and talk,
    -- and they never party, hunt, or leave. 0 turns the feature off, and then nothing else changes.
    CITIZENS            = 0,   -- How many pool bots are citizens. They log in first and count toward MAX_ONLINE
    CITIZEN_ZONE        = 230, -- The city they live in (Southern San d'Oria)
    CITIZEN_SAY_MINUTES = 4,   -- About how often each citizen speaks in /say, and only with a real player within 30 yalms. 0 turns it off

    PLAYER_LEEWAY        = 40, -- Yalms. Bots leave a real player's mobs alone inside this, and aren't placed this close. They still fight back
    LEVEL_WINDOW         = 10, -- Levels. Balance won't send a bot further than this from the player; invites use it, and logins prefer it

    -- Chat through any OpenAI-style chat completions endpoint. Personalities are in bot_pool.personality.
    -- Default is the local llama-server (systemctl --user start lsb-chat). For a hosted API, e.g. OpenAI:
    --   LLM_URL = 'https://api.openai.com/v1/chat/completions', LLM_API_KEY = 'sk-...', LLM_MODEL = 'gpt-4o-mini'
    -- An API key here is a secret: keep this file private (chmod 600).
    CHAT_ENABLED = true,
    LLM_URL      = 'http://127.0.0.1:8085/v1/chat/completions',
    LLM_API_KEY  = '', -- sent as "Authorization: Bearer <key>" when set
    LLM_MODEL    = '', -- required by hosted APIs; llama-server ignores it
    LLM_TIMEOUT  = 30, -- seconds
    LLM_THINK_TOKENS = 0, -- added to each reply's token limit for a reasoning model, whose thinking counts against it; 0 for others
    LLM_ORDERS   = true, -- the model reads party chat for requests and picks which bot does what; false uses keyword matching

    CHAT_PARTY_MINUTES = 4,  -- About this often a bot in your party starts some small talk (and sometimes after a fight). 0 turns it off
    CHAT_SHOUT_MINUTES = 10, -- About this often a bot without a party shouts for one, when real players are in its zone. 0 turns it off

    -- Half the pool wears this linkshell's pearl; send any of them a tell asking for a pearl to join. Letters only; '' turns it off
    LINKSHELL              = 'Wanderers',
    CHAT_LINKSHELL_MINUTES = 6, -- About this often someone in it says something, while a real player wears the pearl. 0 turns it off
}
